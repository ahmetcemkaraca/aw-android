<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/varela_round"
            android:text="Permissions and data sources"
            android:textSize="24sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose only the permissions needed for the sources you want to use. Manual entries and saved reports work without capture permissions." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="App usage"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/checkmarkUsage"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="Usage access status"
                android:paddingEnd="10dp"
                android:src="@drawable/ic_x" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Optional. Reads app/package names and active times while Recording is on. Manual mode remains available without access." />
            <Button
                android:id="@+id/btnGrantUsagePermission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Review" />
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Browser URLs and page titles"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/checkmarkAccessibility"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="Accessibility status"
                android:paddingEnd="10dp"
                android:src="@drawable/ic_x" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Optional. A separate disclosure appears before Accessibility settings. This source stays off until you enable it." />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchBrowserCapture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Enable browser URL and title capture" />
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Media playback"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/checkmarkNotification"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="Media access status"
                android:paddingEnd="10dp"
                android:src="@drawable/ic_x" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Optional. Reads app, track, artist, album and playback state; posted notification text is ignored." />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchMediaCapture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Enable media playback capture" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
